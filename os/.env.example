# Copy to .env.local for local use. Set the same values on the host when deployed.

# Signs login sessions. Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Postgres connection string (Supabase, Neon or any other Postgres).
# Required once deployed, because the two founders must share one database.
# Left empty, the app keeps a local database in os/.data/ on this computer only.
DATABASE_URL=
